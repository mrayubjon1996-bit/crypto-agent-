<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>CryptoSint Pro — Blockchain Intelligence</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow+Condensed:wght@300;400;600;700;900&family=Barlow:wght@300;400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #07090f;
  --bg2: #0d1117;
  --bg3: #111827;
  --panel: #0f1520;
  --border: #1e2d45;
  --border2: #243347;
  --accent: #00d4ff;
  --accent2: #0099cc;
  --green: #00ff88;
  --red: #ff3366;
  --orange: #ff8c00;
  --yellow: #ffd700;
  --purple: #a855f7;
  --text: #c8d8e8;
  --text2: #7a9ab5;
  --text3: #3d5a70;
  --mono: 'Share Tech Mono', monospace;
  --head: 'Barlow Condensed', sans-serif;
  --body: 'Barlow', sans-serif;
}

html, body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--body);
  height: 100%;
  width: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,212,255,0.015) 2px, rgba(0,212,255,0.015) 4px);
  pointer-events: none;
  z-index: 9999;
}

#topbar {
  height: 52px;
  background: var(--bg2);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 16px;
  gap: 20px;
  flex-shrink: 0;
}

.logo {
  font-family: var(--head);
  font-weight: 900;
  font-size: 22px;
  letter-spacing: 4px;
  color: var(--accent);
  text-shadow: 0 0 20px rgba(0,212,255,0.5);
  text-transform: uppercase;
}
.logo span { color: var(--green); }

.top-status {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--text2);
}

.status-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 8px var(--green);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.top-actions {  margin-left: auto;
  display: flex;
  gap: 8px;
}

.btn {
  font-family: var(--head);
  font-weight: 600;
  font-size: 13px;
  letter-spacing: 1px;
  padding: 6px 14px;
  border: 1px solid var(--border2);
  background: transparent;
  color: var(--text);
  cursor: pointer;
  transition: all 0.15s;
  text-transform: uppercase;
}
.btn:hover { border-color: var(--accent); color: var(--accent); background: rgba(0,212,255,0.05); }
.btn.primary { background: var(--accent); color: #000; border-color: var(--accent); font-weight: 700; }
.btn.primary:hover { background: #00b8d9; }
.btn.danger { border-color: var(--red); color: var(--red); }
.btn.danger:hover { background: rgba(255,51,102,0.1); }
.btn.success { border-color: var(--green); color: var(--green); }
.btn.success:hover { background: rgba(0,255,136,0.08); }
.btn.warn { border-color: var(--orange); color: var(--orange); }
.btn.warn:hover { background: rgba(255,140,0,0.08); }

#main {
  flex: 1;
  display: flex;
  overflow: hidden;
  height: calc(100vh - 52px);
}

#left-panel {
  width: 280px;
  min-width: 280px;
  background: var(--panel);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.panel-section {
  border-bottom: 1px solid var(--border);
  padding: 12px;
}
.section-title {
  font-family: var(--head);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--text3);
  text-transform: uppercase;
  margin-bottom: 10px;
}

.search-wrap { display: flex; gap: 6px; }

.input {
  flex: 1;
  background: var(--bg3);
  border: 1px solid var(--border2);
  color: var(--text);
  font-family: var(--mono);
  font-size: 11px;
  padding: 7px 10px;
  outline: none;
  transition: border-color 0.15s;
}
.input:focus { border-color: var(--accent); }
.input::placeholder { color: var(--text3); }

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.stat-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  padding: 8px 10px;
}

.stat-val {
  font-family: var(--mono);
  font-size: 18px;
  color: var(--accent);
  line-height: 1;
}

.stat-lbl {
  font-size: 10px;
  color: var(--text3);
  text-transform: uppercase;
  letter-spacing: 1px;  margin-top: 3px;
}

#node-list {
  flex: 1;
  overflow-y: auto;
  padding: 8px;
}

#node-list::-webkit-scrollbar { width: 4px; }
#node-list::-webkit-scrollbar-track { background: var(--bg); }
#node-list::-webkit-scrollbar-thumb { background: var(--border2); }

.node-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 8px;
  cursor: pointer;
  border: 1px solid transparent;
  margin-bottom: 2px;
  transition: all 0.1s;
}

.node-item:hover { background: rgba(0,212,255,0.05); border-color: var(--border); }
.node-item.active { background: rgba(0,212,255,0.08); border-color: var(--accent); }

.node-dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}

.node-info { flex: 1; overflow: hidden; }

.node-label {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.node-type {
  font-size: 10px;
  color: var(--text3);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.risk-badge {
  font-family: var(--mono);
  font-size: 10px;
  padding: 2px 5px;
  border: 1px solid;
  flex-shrink: 0;
}

#graph-container {
  flex: 1;
  position: relative;
  background: var(--bg);
  overflow: hidden;
  height: 100%;
}

#graph-canvas {
  width: 100%;
  height: 100%;
  display: block;
  cursor: grab;
}

#graph-canvas:active { cursor: grabbing; }

#graph-controls {
  position: absolute;
  top: 12px;
  left: 12px;
  display: flex;
  gap: 6px;
  flex-direction: column;
}

.icon-btn {
  width: 32px; height: 32px;
  background: var(--panel);
  border: 1px solid var(--border2);
  color: var(--text2);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  transition: all 0.15s;
}

.icon-btn:hover { border-color: var(--accent); color: var(--accent); }
#graph-info-bar {
  position: absolute;
  bottom: 12px;
  left: 12px;
  right: 12px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  pointer-events: none;
}

.graph-legend {
  display: flex;
  gap: 14px;
  background: rgba(13,17,23,0.9);
  border: 1px solid var(--border);
  padding: 8px 12px;
  pointer-events: all;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  color: var(--text2);
}

.legend-dot {
  width: 9px; height: 9px;
  border-radius: 50%;
}

#right-panel {
  width: 420px;
  min-width: 420px;
  background: var(--panel);
  border-left: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.tab-bar {
  display: flex;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.tab {  flex: 1;
  padding: 11px 4px;
  font-family: var(--head);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--text3);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  text-align: center;
  transition: all 0.15s;
  background: transparent;
  border-right: 1px solid var(--border);
}

.tab:last-child { border-right: none; }
.tab:hover { color: var(--text2); }
.tab.active { color: var(--accent); border-bottom-color: var(--accent); }

.quick-actions {
  padding: 10px 12px;
  border-bottom: 1px solid var(--border);
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  flex-shrink: 0;
}

#ai-chat {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

#chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

#chat-messages::-webkit-scrollbar { width: 4px; }
#chat-messages::-webkit-scrollbar-track { background: var(--bg); }
#chat-messages::-webkit-scrollbar-thumb { background: var(--border2); }

.msg {  max-width: 100%;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

.msg-user {
  background: rgba(0,212,255,0.08);
  border: 1px solid rgba(0,212,255,0.2);
  border-radius: 2px;
  padding: 8px 10px;
  font-size: 13px;
  color: var(--text);
  align-self: flex-end;
  max-width: 90%;
}

.msg-ai {
  border: 1px solid var(--border);
  border-left: 2px solid var(--accent);
  padding: 10px 12px;
  background: var(--bg2);
}

.msg-ai-header {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--accent);
  margin-bottom: 6px;
  letter-spacing: 1px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.msg-ai-header::before {
  content: '▶';
  font-size: 8px;
}

.msg-ai-body {
  font-size: 13px;
  color: var(--text);
  line-height: 1.65;
  white-space: pre-wrap;
  word-wrap: break-word;
}
.msg-ai-body strong { color: var(--accent); font-weight: 600; }
.msg-ai-body .risk-high { color: var(--red); font-weight: 600; }
.msg-ai-body .risk-med { color: var(--orange); font-weight: 600; }
.msg-ai-body .risk-low { color: var(--green); font-weight: 600; }
.msg-ai-body code {
  background: var(--bg3);
  padding: 1px 5px;
  border-radius: 2px;
  font-family: var(--mono);
  font-size: 12px;
  color: var(--yellow);
}
.msg-ai-body h4 {
  color: var(--accent);
  font-family: var(--head);
  font-size: 14px;
  margin: 8px 0 4px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.msg-system {
  text-align: center;
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text3);
  padding: 4px 0;
}

.typing {
  display: flex;
  gap: 4px;
  align-items: center;
  padding: 12px;
  border: 1px solid var(--border);
  border-left: 2px solid var(--accent);
  background: var(--bg2);
}

.typing-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--accent);
  animation: bounce 1.2s infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

#chat-input-area {
  padding: 10px 12px;
  border-top: 1px solid var(--border);
  display: flex;
  gap: 6px;
  flex-shrink: 0;
}

#chat-input {
  flex: 1;
  background: var(--bg3);
  border: 1px solid var(--border2);
  color: var(--text);
  font-family: var(--body);
  font-size: 13px;
  padding: 8px 10px;
  outline: none;
  resize: none;
  height: 70px;
  transition: border-color 0.15s;
}

#chat-input:focus { border-color: var(--accent); }
#chat-input::placeholder { color: var(--text3); }

.send-col {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

/* ANALYTICS TAB */
.analytics-content {
  flex: 1;
  overflow-y: auto;
  padding: 14px;
}

.analytics-content::-webkit-scrollbar { width: 4px; }
.analytics-content::-webkit-scrollbar-track { background: var(--bg); }
.analytics-content::-webkit-scrollbar-thumb { background: var(--border2); }

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;  gap: 8px;
  margin-bottom: 16px;
}

.metric-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  padding: 10px;
  position: relative;
  overflow: hidden;
}

.metric-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 3px; height: 100%;
  background: var(--accent);
}

.metric-card.risk-high::before { background: var(--red); }
.metric-card.risk-med::before { background: var(--orange); }
.metric-card.risk-low::before { background: var(--green); }

.metric-val {
  font-family: var(--mono);
  font-size: 22px;
  color: var(--accent);
  line-height: 1;
}

.metric-lbl {
  font-size: 10px;
  color: var(--text3);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-top: 4px;
}

.metric-sub {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text2);
  margin-top: 2px;
}

.chart-box {
  background: var(--bg3);
  border: 1px solid var(--border);
  padding: 12px;  margin-bottom: 12px;
}

.chart-title {
  font-family: var(--head);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  color: var(--text2);
  text-transform: uppercase;
  margin-bottom: 10px;
}

.chart-wrap {
  position: relative;
  height: 180px;
}

.alerts-list {
  background: var(--bg3);
  border: 1px solid var(--border);
  padding: 10px;
}

.alert-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 8px 0;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
}

.alert-item:last-child { border-bottom: none; }

.alert-icon {
  font-size: 14px;
  flex-shrink: 0;
  margin-top: 1px;
}

.alert-body { flex: 1; }

.alert-title {
  font-family: var(--head);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 2px;
}
.alert-title.high { color: var(--red); }
.alert-title.medium { color: var(--orange); }
.alert-title.low { color: var(--yellow); }

.alert-desc {
  color: var(--text2);
  font-size: 11px;
  line-height: 1.4;
}

/* MODAL */
#modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
}

#modal-overlay.active { display: flex; }

.modal {
  background: var(--panel);
  border: 1px solid var(--border2);
  width: 600px;
  max-width: 90vw;
  max-height: 80vh;
  overflow-y: auto;
  padding: 24px;
  position: relative;
}

.modal-title {
  font-family: var(--head);
  font-weight: 700;
  font-size: 20px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text);
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.modal-close {
  position: absolute;
  top: 16px; right: 16px;  background: none;
  border: 1px solid var(--border2);
  color: var(--text2);
  width: 28px; height: 28px;
  cursor: pointer;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close:hover { border-color: var(--red); color: var(--red); }

.dropzone {
  border: 2px dashed var(--border2);
  padding: 32px;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
  margin-bottom: 12px;
}

.dropzone:hover, .dropzone.drag { border-color: var(--accent); background: rgba(0,212,255,0.03); }
.dropzone-icon { font-size: 32px; margin-bottom: 8px; color: var(--text3); }
.dropzone-text { font-family: var(--mono); font-size: 12px; color: var(--text2); }

textarea.report-out {
  width: 100%;
  height: 300px;
  background: var(--bg);
  border: 1px solid var(--border2);
  color: var(--green);
  font-family: var(--mono);
  font-size: 11px;
  padding: 12px;
  outline: none;
  resize: vertical;
}

#toast {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%) translateY(80px);
  background: var(--panel);
  border: 1px solid var(--accent);
  color: var(--text);
  font-family: var(--mono);
  font-size: 12px;
  padding: 10px 20px;  z-index: 9999;
  transition: transform 0.3s ease;
  pointer-events: none;
}

#toast.show { transform: translateX(-50%) translateY(0); }

.tab-content {
  display: none;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}

.tab-content.active { display: flex; }
</style>
</head>
<body>

<div id="topbar">
  <div class="logo">Crypto<span>Sint</span> Pro</div>
  <div class="top-status">
    <div class="status-dot"></div>
    <span>AI AGENT ONLINE</span>
  </div>
  <div class="top-status" style="margin-left:12px">
    <div class="status-dot" style="background:var(--orange);box-shadow:0 0 8px var(--orange)"></div>
    <span id="etherscan-status">ETHERSCAN: KEY NEEDED</span>
  </div>
  <div class="top-actions">
    <button class="btn" onclick="openImport()">⬆ Import</button>
    <button class="btn" onclick="openExport()">⬇ Export</button>
    <button class="btn warn" onclick="quickAnalyzeAll()">⚡ AI Analysis</button>
    <button class="btn" onclick="openSettings()">⚙ Settings</button>
  </div>
</div>

<div id="main">

  <div id="left-panel">
    <div class="panel-section">
      <div class="section-title">Add Address</div>
      <div class="search-wrap">
        <input class="input" id="addr-input" placeholder="0x... or ENS name" />
        <button class="btn primary" onclick="addAddressFromInput()" style="padding:6px 10px">+</button>
      </div>
      <div style="margin-top:6px;display:flex;gap:4px">
        <button class="btn" style="font-size:11px;padding:4px 8px;flex:1" onclick="fetchEtherscan()">Fetch Onchain</button>
        <button class="btn" style="font-size:11px;padding:4px 8px;flex:1" onclick="autoLink()">Auto-Link</button>
      </div>    </div>
    <div class="panel-section">
      <div class="section-title">Investigation Stats</div>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-val" id="stat-nodes">16</div>
          <div class="stat-lbl">Nodes</div>
        </div>
        <div class="stat-card">
          <div class="stat-val" id="stat-edges">21</div>
          <div class="stat-lbl">Connections</div>
        </div>
        <div class="stat-card">
          <div class="stat-val risk-high" id="stat-high" style="color:var(--red)">5</div>
          <div class="stat-lbl">High Risk</div>
        </div>
        <div class="stat-card">
          <div class="stat-val" id="stat-volume" style="color:var(--yellow)">2.4M</div>
          <div class="stat-lbl">Vol (USD)</div>
        </div>
      </div>
    </div>
    <div class="panel-section" style="padding-bottom:6px">
      <div class="section-title">Node Registry</div>
      <input class="input" id="filter-input" placeholder="filter by label or type..." oninput="filterNodes()" style="width:100%;margin-bottom:8px" />
    </div>
    <div id="node-list"></div>
  </div>

  <div id="graph-container">
    <canvas id="graph-canvas"></canvas>
    <div id="graph-controls">
      <button class="icon-btn" onclick="zoomIn()" title="Zoom In">+</button>
      <button class="icon-btn" onclick="zoomOut()" title="Zoom Out">−</button>
      <button class="icon-btn" onclick="resetView()" title="Reset">⌂</button>
      <button class="icon-btn" onclick="togglePhysics()" id="physics-btn" title="Toggle Physics">⚛</button>
      <button class="icon-btn" onclick="toggleLabels()" title="Toggle Labels">T</button>
    </div>
    <div id="graph-info-bar">
      <div class="graph-legend">
        <div class="legend-item"><div class="legend-dot" style="background:#00d4ff"></div>Wallet</div>
        <div class="legend-item"><div class="legend-dot" style="background:#00ff88"></div>Exchange</div>
        <div class="legend-item"><div class="legend-dot" style="background:#ff3366"></div>Mixer</div>
        <div class="legend-item"><div class="legend-dot" style="background:#ff8c00"></div>Contract</div>
        <div class="legend-item"><div class="legend-dot" style="background:#a855f7"></div>Bridge</div>
        <div class="legend-item"><div class="legend-dot" style="background:#ffd700"></div>Suspect</div>
      </div>
      <div style="font-family:var(--mono);font-size:10px;color:var(--text3)" id="hover-info"></div>
