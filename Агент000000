function downloadReport(encoded) {
  const text = decodeURIComponent(encoded);
  const blob = new Blob([text], { type: 'text/plain' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = 'cryptosint-report.txt'; a.click();
}

function exportCSV() {
  const rows = ['id,label,type,risk,address,volume,tx,note'];
  nodes.forEach(n => rows.push(`${n.id},${n.label},${n.type},${n.risk},${n.address},${n.volume},${n.tx},"${n.note||''}"`));
  const blob = new Blob([rows.join('\n')], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = 'cryptosint-nodes.csv'; a.click();
  showToast('CSV exported');
}

function exportJSON() {
  const data = { nodes, edges, exportDate: new Date().toISOString() };
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = 'cryptosint-graph.json'; a.click();
  showToast('JSON exported');
}

