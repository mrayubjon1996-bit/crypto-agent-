=== ANOMALIES ===
${report.anomalies.map(a => `- ${a.type} at ${a.node}: ${a.description}`).join('\n') || 'None'}

Instructions: Reference exact node IDs, trace money flows from mixers to exits. Be concise and analytical. Use markdown formatting: **bold**, \`code\`, lists. Format risk levels as: 🔴 HIGH, 🟠 MEDIUM, 🟢 LOW. Always answer in Russian.`;
}

async function callAI(userMessage, systemOverride = null) {
  const systemContext = systemOverride || buildGraphContext();
  const fullPrompt = `<|system|>\n${systemContext}\n<|user|>\n${userMessage}\n<|assistant|>\n`;

  try {
    const response = await fetch('https://api-inference.huggingface.co/models/Qwen/Qwen2.5-72B-Instruct', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        inputs: fullPrompt,
        parameters: { max_new_tokens: 800, temperature: 0.7, stop: ["<|user|>", "<|system|>"] }
      })
    });

    if (!response.ok) throw new Error(`HTTP error ${response.status}`);
    const data = await response.json();

    let aiText = "";
    if (Array.isArray(data) && data[0]?.generated_text) {
      aiText = data[0].generated_text.replace(fullPrompt, "").trim();
    } else if (data.generated_text) {
      aiText = data.generated_text.replace(fullPrompt, "").trim();
    } else {
      aiText = "Ошибка генерации текста ИИ.";
    }
    return aiText;
  } catch (error) {
    console.error(error);
    throw new Error("Не удалось получить ответ онлайн-модели. Проверьте сеть.");
  }
}

