// ═══════════════════════════════════════════════════════
// GRAPH ANALYTICS ENGINE
// ═══════════════════════════════════════════════════════

class GraphAnalytics {
  constructor(nodes, edges) {
    this.nodes = nodes;
    this.edges = edges;
    this.adjacency = this.buildAdjacency();
  }

  buildAdjacency() {
    const adj = {};
    this.nodes.forEach(n => adj[n.id] = []);
    this.edges.forEach(e => {
      if (!adj[e.from]) adj[e.from] = [];
      if (!adj[e.to]) adj[e.to] = [];
      adj[e.from].push({ to: e.to, volume: e.volume });
    });
    return adj;
  }
  // PageRank algorithm
  pageRank(damping = 0.85, iterations = 30) {
    const N = this.nodes.length;
    const ranks = {};
    this.nodes.forEach(n => ranks[n.id] = 1 / N);

    for (let iter = 0; iter < iterations; iter++) {
      const newRanks = {};
      this.nodes.forEach(n => newRanks[n.id] = (1 - damping) / N);

      this.nodes.forEach(n => {
        const outDegree = this.adjacency[n.id]?.length || 1;
        const share = ranks[n.id] / outDegree;
        (this.adjacency[n.id] || []).forEach(edge => {
          newRanks[edge.to] = (newRanks[edge.to] || 0) + damping * share;
        });
      });

      Object.assign(ranks, newRanks);
    }

    return ranks;
  }

  // BFS path finding
  findPath(startId, endId) {
    const visited = new Set();
    const queue = [[startId]];
    visited.add(startId);

    while (queue.length > 0) {
      const path = queue.shift();
      const current = path[path.length - 1];

      if (current === endId) return path;

      (this.adjacency[current] || []).forEach(edge => {
        if (!visited.has(edge.to)) {
          visited.add(edge.to);
          queue.push([...path, edge.to]);
        }
      });
    }
    return null;
  }

  // Find all paths through mixers
  findMixerPaths() {
    const mixers = this.nodes.filter(n => n.type === 'mixer').map(n => n.id);
    const exchanges = this.nodes.filter(n => n.type === 'exchange').map(n => n.id);    const paths = [];

    mixers.forEach(mixer => {
      exchanges.forEach(exchange => {
        const path = this.findPath(mixer, exchange);
        if (path) {
          const totalVolume = this.calculatePathVolume(path);
          paths.push({
            path,
            volume: totalVolume,
            mixer,
            exchange,
            length: path.length
          });
        }
      });
    });

    return paths.sort((a, b) => b.volume - a.volume);
  }

  calculatePathVolume(path) {
    let total = 0;
    for (let i = 0; i < path.length - 1; i++) {
      const edge = this.edges.find(e => e.from === path[i] && e.to === path[i + 1]);
      if (edge) total += edge.volume;
    }
    return total;
  }

  // Detect patterns
  detectPatterns() {
    const patterns = [];

    // Mixer flow pattern
    const mixers = this.nodes.filter(n => n.type === 'mixer');
    mixers.forEach(mixer => {
      const incoming = this.edges.filter(e => e.to === mixer.id);
      const outgoing = this.edges.filter(e => e.from === mixer.id);
      if (incoming.length > 0 && outgoing.length > 0) {
        const inVol = incoming.reduce((s, e) => s + e.volume, 0);
        const outVol = outgoing.reduce((s, e) => s + e.volume, 0);
        patterns.push({
          type: 'MIXER_FLOW',
          severity: 'high',
          node: mixer.id,
          description: `Mixer ${mixer.id}: $${this.formatNum(inVol)} IN → $${this.formatNum(outVol)} OUT`,
          inCount: incoming.length,
          outCount: outgoing.length
        });      }
    });

    // Fan-out pattern (one source to many destinations)
    this.nodes.forEach(n => {
      const outgoing = this.edges.filter(e => e.from === n.id);
      if (outgoing.length >= 3) {
        patterns.push({
          type: 'FAN_OUT',
          severity: outgoing.length >= 5 ? 'high' : 'medium',
          node: n.id,
          description: `Node ${n.id} sends to ${outgoing.length} destinations (possible distribution)`,
          count: outgoing.length
        });
      }
    });

    // Consolidation pattern (many sources to one destination)
    this.nodes.forEach(n => {
      const incoming = this.edges.filter(e => e.to === n.id);
      if (incoming.length >= 3) {
        patterns.push({
          type: 'CONSOLIDATION',
          severity: 'medium',
          node: n.id,
          description: `Node ${n.id} receives from ${incoming.length} sources (possible aggregation)`,
          count: incoming.length
        });
      }
    });

    // Circular flow detection
    this.nodes.forEach(n => {
      const path = this.findPath(n.id, n.id);
      if (path && path.length > 2) {
        patterns.push({
          type: 'CIRCULAR_FLOW',
          severity: 'high',
          node: n.id,
          description: `Circular flow detected: ${path.join(' → ')}`,
          path
        });
      }
    });

    return patterns;
  }

  // Detect anomalies
  detectAnomalies() {    const anomalies = [];
    const volumes = this.nodes.map(n => parseInt(n.volume) || 0);
    const mean = volumes.reduce((s, v) => s + v, 0) / volumes.length;
    const stdDev = Math.sqrt(volumes.reduce((s, v) => s + (v - mean) ** 2, 0) / volumes.length);

    this.nodes.forEach(n => {
      const vol = parseInt(n.volume) || 0;
      const zScore = (vol - mean) / stdDev;

      if (Math.abs(zScore) > 2) {
        anomalies.push({
          type: 'HIGH_VOLUME',
          severity: zScore > 3 ? 'high' : 'medium',
          node: n.id,
          description: `Volume $${this.formatNum(vol)} is ${zScore.toFixed(1)}σ from mean`,
          zScore: zScore.toFixed(2)
        });
      }
    });

    // High transaction count anomaly
    const txCounts = this.nodes.map(n => n.tx || 0);
    const txMean = txCounts.reduce((s, v) => s + v, 0) / txCounts.length;
    const txStd = Math.sqrt(txCounts.reduce((s, v) => s + (v - txMean) ** 2, 0) / txCounts.length);

    this.nodes.forEach(n => {
      const tx = n.tx || 0;
      const zScore = (tx - txMean) / txStd;
      if (zScore > 2.5) {
        anomalies.push({
          type: 'HIGH_TX_COUNT',
          severity: 'medium',
          node: n.id,
          description: `Transaction count ${tx} is ${zScore.toFixed(1)}σ from mean`,
          zScore: zScore.toFixed(2)
        });
      }
    });

    return anomalies;
  }

  // Cluster detection (simple connected components)
  findClusters() {
    const visited = new Set();
    const clusters = [];

    this.nodes.forEach(n => {
      if (!visited.has(n.id)) {
        const cluster = [];        const queue = [n.id];
        visited.add(n.id);

        while (queue.length > 0) {
          const current = queue.shift();
          cluster.push(current);

          (this.adjacency[current] || []).forEach(edge => {
            if (!visited.has(edge.to)) {
              visited.add(edge.to);
              queue.push(edge.to);
            }
          });

          // Also check incoming edges
          this.edges.forEach(e => {
            if (e.to === current && !visited.has(e.from)) {
              visited.add(e.from);
              queue.push(e.from);
            }
          });
        }

        if (cluster.length > 1) clusters.push(cluster);
      }
    });

    return clusters;
  }

  // Calculate overall risk score
  calculateRiskScore() {
    const riskWeights = { high: 1.0, medium: 0.5, low: 0.1 };
    const typeWeights = { mixer: 1.0, suspect: 0.9, bridge: 0.6, contract: 0.5, exchange: 0.2, wallet: 0.3 };

    let totalRisk = 0;
    let maxRisk = 0;

    this.nodes.forEach(n => {
      const riskScore = (riskWeights[n.risk] || 0.5) * (typeWeights[n.type] || 0.5);
      totalRisk += riskScore;
      maxRisk += 1.0;
    });

    const patterns = this.detectPatterns();
    const patternRisk = patterns.filter(p => p.severity === 'high').length * 0.1;

    return Math.min(1.0, (totalRisk / maxRisk) + patternRisk);
  }
  formatNum(num) {
    if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
    if (num >= 1000) return (num / 1000).toFixed(0) + 'K';
    return num.toString();
  }

  generateReport() {
    const pageRank = this.pageRank();
    const mixerPaths = this.findMixerPaths();
    const patterns = this.detectPatterns();
    const anomalies = this.detectAnomalies();
    const clusters = this.findClusters();
    const riskScore = this.calculateRiskScore();

    return {
      overallRisk: riskScore,
      pageRank,
      mixerPaths,
      patterns,
      anomalies,
      clusters,
      nodeCount: this.nodes.length,
      edgeCount: this.edges.length,
      highRiskNodes: this.nodes.filter(n => n.risk === 'high').length,
      totalVolume: this.nodes.reduce((s, n) => s + (parseInt(n.volume) || 0), 0)
    };
  }
}

// ═══════════════════════════════════════════════════════
// GRAPH ENGINE
// ═══════════════════════════════════════════════════════

const canvas = document.getElementById('graph-canvas');
const ctx = canvas.getContext('2d');

let positions = {};
let velocities = {};
let transform = { x: 0, y: 0, scale: 1 };
let isDragging = false;
let dragNode = null;
let lastMouse = { x: 0, y: 0 };
let physicsOn = true;
let showLabels = true;
let animFrame;

function initPositions() {
  const cx = canvas.width / 2, cy = canvas.height / 2;
  nodes.forEach((n, i) => {
    if (!positions[n.id]) {      const angle = (i / nodes.length) * Math.PI * 2;
      const r = 180 + Math.random() * 80;
      positions[n.id] = { x: cx + Math.cos(angle) * r, y: cy + Math.sin(angle) * r };
      velocities[n.id] = { x: 0, y: 0 };
    }
  });
}

function resizeCanvas() {
  const container = document.getElementById('graph-container');
  canvas.width = container.clientWidth;
  canvas.height = container.clientHeight;
}

function getNodeRadius(n) {
  const vol = parseInt((n.volume || '0').replace(/,/g, ''));
  return Math.max(14, Math.min(28, 14 + vol / 200000));
}

function applyPhysics() {
  if (!physicsOn) return;
  const repulsion = 3500, spring = 0.025, damping = 0.82, gravity = 0.008;
  const cx = canvas.width / 2, cy = canvas.height / 2;

  nodes.forEach(a => {
    if (!positions[a.id]) return;
    const pa = positions[a.id], va = velocities[a.id];

    nodes.forEach(b => {
      if (a.id === b.id || !positions[b.id]) return;
      const pb = positions[b.id];
      const dx = pa.x - pb.x, dy = pa.y - pb.y;
      const dist = Math.sqrt(dx*dx + dy*dy) || 1;
      const f = repulsion / (dist * dist);
      va.x += (dx / dist) * f;
      va.y += (dy / dist) * f;
    });

    va.x += (cx - pa.x) * gravity;
    va.y += (cy - pa.y) * gravity;
    va.x *= damping; va.y *= damping;
    pa.x += va.x; pa.y += va.y;
  });

  edges.forEach(e => {
    const pa = positions[e.from], pb = positions[e.to];
    if (!pa || !pb) return;
    const dx = pb.x - pa.x, dy = pb.y - pa.y;
    const dist = Math.sqrt(dx*dx + dy*dy) || 1;
    const ideal = 160;    const f = (dist - ideal) * spring;
    const vf = velocities[e.from], vt = velocities[e.to];
    vf.x += (dx / dist) * f; vf.y += (dy / dist) * f;
    vt.x -= (dx / dist) * f; vt.y -= (dy / dist) * f;
  });
}

function drawArrow(x1, y1, x2, y2, color, width, dashed) {
  ctx.save();
  if (dashed) ctx.setLineDash([5, 4]);
  ctx.strokeStyle = color;
  ctx.lineWidth = width;
  const angle = Math.atan2(y2 - y1, x2 - x1);
  const len = Math.sqrt((x2-x1)**2 + (y2-y1)**2);
  const ex = x1 + Math.cos(angle) * (len - 14);
  const ey = y1 + Math.sin(angle) * (len - 14);
  ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(ex, ey); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = color;
  ctx.beginPath();
  ctx.moveTo(ex + Math.cos(angle) * 8, ey + Math.sin(angle) * 8);
  ctx.lineTo(ex + Math.cos(angle + 2.4) * 5, ey + Math.sin(angle + 2.4) * 5);
  ctx.lineTo(ex + Math.cos(angle - 2.4) * 5, ey + Math.sin(angle - 2.4) * 5);
  ctx.closePath(); ctx.fill();
  ctx.restore();
}

function render() {
  applyPhysics();
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  ctx.save();
  ctx.translate(transform.x, transform.y);
  ctx.scale(transform.scale, transform.scale);

  // Grid
  ctx.strokeStyle = 'rgba(30,45,69,0.4)';
  ctx.lineWidth = 0.5;
  for (let x = -1000; x < 3000; x += 60) {
    ctx.beginPath(); ctx.moveTo(x, -1000); ctx.lineTo(x, 3000); ctx.stroke();
  }
  for (let y = -1000; y < 3000; y += 60) {
    ctx.beginPath(); ctx.moveTo(-1000, y); ctx.lineTo(3000, y); ctx.stroke();
  }

  // Edges
  edges.forEach(e => {
    const pa = positions[e.from], pb = positions[e.to];
    if (!pa || !pb) return;
    const fromNode = nodes.find(n => n.id === e.from);    const toNode = nodes.find(n => n.id === e.to);
    const isSuspicious = fromNode?.risk === 'high' || toNode?.risk === 'high';
    const isMixer = fromNode?.type === 'mixer' || toNode?.type === 'mixer';

    let color = 'rgba(30,45,69,0.8)';
    if (isMixer) color = 'rgba(255,51,102,0.5)';
    else if (isSuspicious) color = 'rgba(255,140,0,0.4)';

    const vol = e.volume || 0;
    const width = Math.max(0.5, Math.min(3, vol / 120000));

    drawArrow(pa.x, pa.y, pb.x, pb.y, color, width, isMixer);

    if (showLabels && e.label) {
      const mx = (pa.x + pb.x) / 2, my = (pa.y + pb.y) / 2;
      ctx.font = '9px Share Tech Mono';
      ctx.fillStyle = 'rgba(120,160,185,0.7)';
      ctx.textAlign = 'center';
      ctx.fillText(e.label, mx, my - 4);
    }
  });

  // Nodes
  nodes.forEach(n => {
    const p = positions[n.id];
    if (!p) return;
    const r = getNodeRadius(n);
    const color = COLORS[n.type] || COLORS.unknown;
    const isSelected = selectedNode?.id === n.id;

    // Risk halo
    if (n.risk === 'high') {
      ctx.beginPath();
      ctx.arc(p.x, p.y, r + 8, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255,51,102,0.3)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 4]);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // Selection ring
    if (isSelected) {
      ctx.beginPath();
      ctx.arc(p.x, p.y, r + 6, 0, Math.PI * 2);
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 2;
      ctx.stroke();
    }
    // Node glow
    const grd = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r * 2.5);
    grd.addColorStop(0, color + '30');
    grd.addColorStop(1, 'transparent');
    ctx.beginPath(); ctx.arc(p.x, p.y, r * 2.5, 0, Math.PI * 2);
    ctx.fillStyle = grd; ctx.fill();

    // Node body
    ctx.beginPath();
    ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
    ctx.fillStyle = '#0d1117';
    ctx.fill();
    ctx.strokeStyle = color;
    ctx.lineWidth = isSelected ? 2.5 : 1.5;
    ctx.stroke();

    // Inner dot
    ctx.beginPath();
    ctx.arc(p.x, p.y, r * 0.35, 0, Math.PI * 2);
    ctx.fillStyle = color;
    ctx.fill();

    // Label
    if (showLabels) {
      ctx.font = `bold 10px Barlow Condensed`;
      ctx.fillStyle = n.risk === 'high' ? '#ff6680' : '#c8d8e8';
      ctx.textAlign = 'center';
      ctx.fillText(n.label, p.x, p.y + r + 14);
    }
  });

  ctx.restore();
  animFrame = requestAnimationFrame(render);
}

