    container.appendChild(div);
  } else {
    const div = document.createElement('div');
    div.className = 'msg msg-ai';
    div.innerHTML = `
      <div class="msg-ai-header">${header || 'CRYPTOSINT AGENT'}</div>
      <div class="msg-ai-body">${formatAIText(content)}</div>
