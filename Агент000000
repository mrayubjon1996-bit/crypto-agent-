async function fetchEtherscan() {
  const addr = document.getElementById('addr-input').value.trim();
  if (!addr) { showToast('Enter an address first'); return; }
  if (!etherscanKey) { openSettings(); showToast('Set Etherscan API key first'); return; }

  showToast('Fetching from Etherscan...');

  try {
    const url = `https://api.etherscan.io/api?module=account&action=balance&address=${addr}&tag=latest&apikey=${etherscanKey}`;
    const res = await fetch(url);
    const data = await res.json();
    if (data.status === '1') {
      const ethBal = (parseInt(data.result) / 1e18).toFixed(4);
      showToast(`Balance: ${ethBal} ETH`);
    } else {
      showToast('Etherscan error: ' + data.message);
    }
  } catch (e) {
    showToast('Network error fetching Etherscan');
  }
}

