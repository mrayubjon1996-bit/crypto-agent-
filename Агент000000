// INTERACTIONS
// ═══════════════════════════════════════════════════════

function getNodeAt(mx, my) {
  const wx = (mx - transform.x) / transform.scale;
  const wy = (my - transform.y) / transform.scale;
  return nodes.find(n => {
    const p = positions[n.id];
    if (!p) return false;
    const r = getNodeRadius(n) + 6;
    return (wx - p.x) ** 2 + (wy - p.y) ** 2 < r * r;
  });
}
canvas.addEventListener('mousedown', e => {
  const rect = canvas.getBoundingClientRect();
  const mx = e.clientX - rect.left, my = e.clientY - rect.top;
  const hit = getNodeAt(mx, my);
  if (hit) {
    dragNode = hit;
    isDragging = false;
  } else {
    isDragging = true;
  }
  lastMouse = { x: mx, y: my };
});

canvas.addEventListener('mousemove', e => {
  const rect = canvas.getBoundingClientRect();
  const mx = e.clientX - rect.left, my = e.clientY - rect.top;
  const hover = getNodeAt(mx, my);
  document.getElementById('hover-info').textContent = hover
    ? `${hover.label} · ${hover.type.toUpperCase()} · RISK: ${hover.risk.toUpperCase()} · VOL: $${hover.volume}`
    : '';

  if (dragNode) {
    const dx = mx - lastMouse.x, dy = my - lastMouse.y;
    const p = positions[dragNode.id];
    p.x += dx / transform.scale;
    p.y += dy / transform.scale;
    velocities[dragNode.id] = { x: 0, y: 0 };
  } else if (isDragging) {
    transform.x += mx - lastMouse.x;
    transform.y += my - lastMouse.y;
  }
  lastMouse = { x: mx, y: my };
});

canvas.addEventListener('mouseup', e => {
  const rect = canvas.getBoundingClientRect();
  const mx = e.clientX - rect.left, my = e.clientY - rect.top;
  if (dragNode && !isDragging) {
    selectNode(dragNode);
  }
  dragNode = null;
  isDragging = false;
});

canvas.addEventListener('click', e => {
  const rect = canvas.getBoundingClientRect();
  const mx = e.clientX - rect.left, my = e.clientY - rect.top;
  const hit = getNodeAt(mx, my);
  if (hit) selectNode(hit);
});
canvas.addEventListener('wheel', e => {
  e.preventDefault();
  const factor = e.deltaY > 0 ? 0.9 : 1.1;
  const rect = canvas.getBoundingClientRect();
  const mx = e.clientX - rect.left, my = e.clientY - rect.top;
  transform.x = mx - (mx - transform.x) * factor;
  transform.y = my - (my - transform.y) * factor;
  transform.scale = Math.max(0.2, Math.min(4, transform.scale * factor));
});

function zoomIn() { transform.scale = Math.min(4, transform.scale * 1.25); }
function zoomOut() { transform.scale = Math.max(0.2, transform.scale * 0.8); }
function resetView() {
  transform = { x: 0, y: 0, scale: 1 };
  initPositions();
}
function togglePhysics() {
  physicsOn = !physicsOn;
  document.getElementById('physics-btn').style.color = physicsOn ? 'var(--accent)' : 'var(--text3)';
}
function toggleLabels() { showLabels = !showLabels; }

