}

function formatAIText(text) {
  return text
    .replace(/####\s*(.*)/g, '<h4>$1</h4>')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/`(.*?)`/g, '<code>$1</code>')
    .replace(/🔴 HIGH/g, '<span class="risk-high">🔴 HIGH</span>')
    .replace(/🟠 MEDIUM/g, '<span class="risk-med">🟠 MEDIUM</span>')
    .replace(/🟢 LOW/g, '<span class="risk-low">🟢 LOW</span>');
}

function showTyping() {
  const container = document.getElementById('chat-messages');
  const div = document.createElement('div');
  div.id = 'typing-indicator';
  div.className = 'typing';
  div.innerHTML = `<div class="msg-ai-header" style="margin-bottom:0">PROCESSING</div>
    <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>`;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function removeTyping() {
  document.getElementById('typing-indicator')?.remove();
}

async function sendChat() {
  const input = document.getElementById('chat-input');
  const msg = input.value.trim();
  if (!msg) return;

  input.value = '';
  addMessage('user', msg);
  chatHistory.push({ role: 'user', content: msg });
  switchTab('ai');  showTyping();

  try {
    const reply = await callAI(msg);
    removeTyping();
    addMessage('ai', reply);
    chatHistory.push({ role: 'assistant', content: reply });
  } catch (err) {
    removeTyping();
    addMessage('system', `⚠ Внимание: ${err.message}`);
  }
}

function handleKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendChat(); }
}

function quickQ(q) {
  document.getElementById('chat-input').value = q;
  sendChat();
}

async function analyzeNodeWithAI(nodeId) {
  const n = nodes.find(x => x.id === nodeId);
  if (!n) return;

  const neighbors = edges
    .filter(e => e.from === n.id || e.to === n.id)
    .map(e => `${e.from === n.id ? '→' : '←'} ${e.from === n.id ? e.to : e.from} (${e.label})`);

  const prompt = `Проведи детальный анализ узла ${n.id}. Тип: ${n.type}, Риск: ${n.risk}, Объем: $${n.volume}, Транзакций: ${n.tx}. Связи: ${neighbors.join(', ')}. 

Укажи:
1. Подозрительные паттерны
2. Потенциальные риски
3. Рекомендуемые шаги расследования
4. Связь с другими высокорисковыми узлами

Ответь структурированно на русском.`;

  switchTab('ai');
  addMessage('user', `Анализ кошелька ${n.id}`);
  showTyping();

  try {
    const reply = await callAI(prompt);
    removeTyping();
    addMessage('ai', reply, `АНАЛИЗ УЗЛА: ${n.id}`);
  } catch (err) {
    removeTyping();    addMessage('system', `⚠ Ошибка: ${err.message}`);
  }
}

