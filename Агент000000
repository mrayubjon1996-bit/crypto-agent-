function handleCSV(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    const lines = ev.target.result.split('\n').filter(l => l.trim());
    const headers = lines[0].split(',').map(h => h.trim());
    let added = 0;
    for (let i = 1; i < lines.length; i++) {
      const vals = lines[i].split(',').map(v => v.trim());
      const obj = {};
      headers.forEach((h, j) => obj[h] = vals[j] || '');
      if (obj.id && !nodes.find(n => n.id === obj.id)) {
        nodes.push({ id: obj.id, label: obj.label||obj.id, type: obj.type||'wallet', risk: obj.risk||'medium', address: obj.address||'', volume: obj.volume||'0', tx: parseInt(obj.tx)||0, note: obj.note||'' });
        const cx = canvas.width/2, cy = canvas.height/2;
        positions[obj.id] = { x: cx + (Math.random()-0.5)*400, y: cy + (Math.random()-0.5)*400 };
        velocities[obj.id] = { x:0, y:0 };
        added++;      }
    }
    renderNodeList();
    renderAnalytics();
    closeModal();
    showToast(`Imported ${added} nodes from CSV`);
  };
  reader.readAsText(file);
}

function loadSampleCSV() {
  const csv = `id,label,type,risk,address,volume,tx,note\nW-020,W-020,wallet,high,0xdead...beef,300000,88,New suspect wallet`;
