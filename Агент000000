  ).join('\n');

  const topPR = Object.entries(report.pageRank)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([id, score]) => `${id}: ${(score * 100).toFixed(1)}%`)
    .join(', ');

  return `You are CryptoSint Pro, an advanced blockchain forensics AI agent with graph analytics capabilities.
=== GRAPH METRICS ===
Overall Risk: ${(report.overallRisk * 100).toFixed(1)}%
